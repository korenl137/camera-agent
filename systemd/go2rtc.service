[Unit]
Description=go2rtc webcam streamer
# Skip (not restart-loop) on a machine that has no local cameras.yaml yet
ConditionPathExists=%h/.config/camera-agent/cameras.yaml

[Service]
EnvironmentFile=%h/.config/camera-agent/env
ExecStart=%h/.local/bin/go2rtc -c %h/Projects/camera-agent/go2rtc.yaml -c %h/.config/camera-agent/cameras.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
